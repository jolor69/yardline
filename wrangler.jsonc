{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yardline",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",

  // Pinned explicitly: a second, unrelated Cloudflare account
  // (joe.lord.ai@gmail.com) also happens to have a Worker named "yardline"
  // (orphaned, workers.dev only, no custom domain/bindings). Without this,
  // `wrangler deploy` can resolve to the wrong account and fail auth, or
  // worse, deploy to the wrong one. This ID is ai.neulab.inc@gmail.com's
  // account — the one that owns yardline.neulab.xyz, the D1 DB, and R2.
  "account_id": "0e2ee5dc3ed565a92c679f44963f12a8",

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/", "/get-started", "/login", "/buyer", "/seller", "/reset-password"
    ]
  },

  // workers_dev must stay explicit — Wrangler silently disables it the
  // moment a `routes` entry exists, which took the site offline once
  // already (2026-07-27) when the custom_domain route below failed to
  // attach. Keep this `true` until yardline.neulab.xyz is confirmed live.
  "workers_dev": true,

  "routes": [
    { "pattern": "yardline.neulab.xyz", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yardline-db",
      // Verified live against `wrangler d1 list` under account_id above
      // (2026-08-02): this is the real yardline-db uuid. A prior commit
      // (fe9cb5f) swapped this to a9c3e832-..., which does not exist in
      // this account — that "fix" was made under account confusion (see
      // the account_id comment above) and broke a working binding.
      "database_id": "abd55551-dc06-448c-9441-da89f05b9d11",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "yardline-photos"
    }
  ],

  // Not a secret — it's public in the t.me/<username> URL itself — so a
  // plain var is fine here. TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET
  // are real secrets, set via `wrangler secret put` (see .dev.vars.example
  // for local dev). Update this once the bot is created via @BotFather.
  "vars": {
    // Verified against the Bot API's own getMe response (2026-08-02) — the
    // registered username has an underscore, unlike what was assumed
    // earlier.
    "TELEGRAM_BOT_USERNAME": "Yardline_bot"
  },

  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
